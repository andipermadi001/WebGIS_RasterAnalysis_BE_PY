# Alternatif hosting (Railway/Render/Fly/Cloud Run) untuk analisis raster berat.
# Wheel rasterio sudah membawa GDAL, jadi tidak perlu apt-get libgdal.
FROM python:3.11-slim

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .

EXPOSE 8000
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}"]
