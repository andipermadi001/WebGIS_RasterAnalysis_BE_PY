# Lokal: salin ke .env. Vercel: isi di Settings -> Environment Variables
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=isi-key-supabase
# Domain frontend, pisahkan koma
CORS_ORIGINS=https://frontend-kamu.vercel.app,http://localhost:5173
# Opsional: host lain yang boleh jadi sumber raster (host Supabase otomatis diizinkan)
# ALLOWED_RASTER_HOSTS=
